#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only

USE_PROCD=1
START=95
STOP=10

start_service() {
	local device
	config_load sacnmon
	config_get device capture interface br-lan

	procd_open_instance
	procd_set_param command /usr/sbin/sacnmond "$device"
	procd_set_param respawn 3600 5 5
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger sacnmon
}

reload_service() {
	if service_running; then
		start
	fi
}
